{
  "manifest_version": 3,
  "name": "SignBridge",
  "short_name": "SignBridge",
  "version": "2.0.0",
  "description": "Real-time ASL sign language bridge for Deaf accessibility — 3D avatar overlay on YouTube, Google Meet, Zoom & Teams.",

  "permissions": [
    "tabCapture",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "offscreen"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://zoom.us/*",
    "https://app.zoom.us/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://web.microsoftstream.com/*",
    "https://www.coursera.org/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://zoom.us/*",
        "https://app.zoom.us/*",
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://web.microsoftstream.com/*",
        "https://www.coursera.org/*"
      ],
      "js": [
        "content/platform-detector.js",
        "content/storage-manager.js",
        "content/sign-mapper.js",
        "content/audio-processor.js",
        "content/avatar-renderer.js",
        "content/avatar-overlay.js",
        "content/content-script.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SignBridge — Sign Language Accessibility",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' https://3dasl-avatar.vercel.app; style-src 'self' https://3dasl-avatar.vercel.app; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com https://3dasl-avatar.vercel.app; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.css",
        "icons/*",
        "content/vocab-10k.json",
        "3d/cwasa-embed.html",
        "3d/cwaclientcfg.json",
        "3d/avatar3d.html",
        "3d/avatar3d.js",
        "3d/pose-library.js",
        "3d/procedural-hand.js",
        "3d/lib/three.module.js",
        "3d/lib/GLTFLoader.js",
        "3d/lib/BufferGeometryUtils.js",
        "3d/models/avatar.glb",
        "d2/recognizer.html",
        "d2/recognizer.js",
        "d2/classifier.js",
        "d2/lib/mediapipe-vision.mjs",
        "d2/models/gesture_recognizer.task"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://zoom.us/*",
        "https://app.zoom.us/*",
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://web.microsoftstream.com/*",
        "https://www.coursera.org/*"
      ]
    }
  ],

  "commands": {
    "toggle-avatar": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle SignBridge avatar overlay"
    },
    "toggle-captions": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle caption display"
    },
    "toggle-sign-recognition": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle sign-to-text recognition (Direction 2)"
    }
  }
}
