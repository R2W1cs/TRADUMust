generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  ADMIN
  SUPER_ADMIN
}

enum SignLanguageCode {
  ASL
  BSL
  LSF
  TSL
}

enum ExerciseType {
  MULTIPLE_CHOICE
  MATCH_IMAGE
  MATCH_SIGN
  FILL_BLANK
  WATCH_AVATAR
  REPEAT_SIGN
  CAMERA_CHALLENGE
  FINGERSPELL
  TRANSLATION
  ARRANGE_SENTENCE
}

enum NotificationType {
  LESSON_REMINDER
  STREAK
  ACHIEVEMENT
  TRANSLATION
  MODEL_UPDATE
  SYSTEM
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  name              String
  avatarUrl         String?
  role              Role      @default(USER)
  preferredLanguage SignLanguageCode @default(ASL)
  theme             String    @default("system")
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  githubId          String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  progress          UserProgress?
  translations      Translation[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  achievements      UserAchievement[]
  badges            UserBadge[]
  certificates      Certificate[]
  notifications     Notification[]
  leaderboardEntries LeaderboardEntry[]
  auditLogs         AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model SignLanguage {
  id          String           @id @default(cuid())
  code        SignLanguageCode @unique
  name        String
  nativeName  String
  region      String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  signs       Sign[]
  units       Unit[]
  animations  Animation[]
}

model Unit {
  id             String       @id @default(cuid())
  signLanguageId String
  title          String
  description    String
  orderIndex     Int
  xpReward       Int          @default(50)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  signLanguage   SignLanguage @relation(fields: [signLanguageId], references: [id], onDelete: Cascade)
  lessons        Lesson[]

  @@index([signLanguageId, orderIndex])
}

model Lesson {
  id          String       @id @default(cuid())
  unitId      String
  title       String
  description String
  category    String
  orderIndex  Int
  xpReward    Int          @default(20)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  quizzes     Quiz[]
  progress    LessonProgress[]

  @@index([unitId, orderIndex])
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  type          ExerciseType
  question      String
  instruction   String
  options       Json?
  correctAnswer String
  signId        String?
  orderIndex    Int
  xpReward      Int          @default(10)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sign          Sign?        @relation(fields: [signId], references: [id])

  @@index([lessonId, orderIndex])
}

model Quiz {
  id          String       @id @default(cuid())
  lessonId    String
  title       String
  passingScore Int         @default(70)
  xpReward    Int          @default(30)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  options       Json
  correctAnswer String
  orderIndex    Int

  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, orderIndex])
}

model Sign {
  id             String       @id @default(cuid())
  signLanguageId String
  gloss          String
  english        String
  description    String?
  animationKey   String?
  fingerspell    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  signLanguage   SignLanguage @relation(fields: [signLanguageId], references: [id], onDelete: Cascade)
  exercises      Exercise[]
  animations     Animation[]

  @@unique([signLanguageId, gloss])
  @@index([english])
}

model Animation {
  id             String       @id @default(cuid())
  signLanguageId String
  signId         String?
  name           String
  keyframes      Json
  duration       Float
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  signLanguage   SignLanguage @relation(fields: [signLanguageId], references: [id], onDelete: Cascade)
  sign           Sign?        @relation(fields: [signId], references: [id])
}

model Dataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  language    SignLanguageCode
  fileUrl     String?
  status      String   @default("pending")
  approvedBy  String?
  recordCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model AiModel {
  id          String   @id @default(cuid())
  name        String
  type        String
  version     String
  language    SignLanguageCode?
  accuracy    Float?
  isActive    Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Translation {
  id           String           @id @default(cuid())
  userId       String?
  inputText    String
  outputText   String?
  signLanguage SignLanguageCode
  gloss        Json?
  confidence   Float?
  duration     Int?
  isFavorite   Boolean          @default(false)
  metadata     Json?
  createdAt    DateTime         @default(now())

  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([isFavorite])
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  lives            Int       @default(5)
  nextLifeRegenAt  DateTime?
  dailyStreak      Int       @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  score       Int?
  xpEarned    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  passed    Boolean
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  icon        String
  xpReward    Int      @default(50)
  createdAt   DateTime @default(now())

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  icon        String
  tier        String   @default("bronze")
  createdAt   DateTime @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Certificate {
  id          String           @id @default(cuid())
  userId      String
  language    SignLanguageCode
  title       String
  description String?
  issuedAt    DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  userId    String
  period    String
  xp        Int
  rank      Int?
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period, xp])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
